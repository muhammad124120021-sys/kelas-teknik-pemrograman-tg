import matplotlib.pyplot as plt

# Data sinyal seismik
waktu = [0, 1, 2, 3, 4, 5, 6, 7]
amplitudo = [0, 5, 8, 3, -2, -4, -1, 0]

# Membuat plot garis
plt.plot(waktu, amplitudo, color='red', marker='o', linewidth=2)

# Menambahkan label dan judul
plt.xlabel('Waktu (ms)')
plt.ylabel('Amplitudo')
plt.title('Trace Seismik')

# Menampilkan grid
plt.grid(True)

plt.show()
