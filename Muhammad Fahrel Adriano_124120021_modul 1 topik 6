# ============================================
# Fungsi Sapaan
# ============================================
def salam(fahrel):
    return f"Halo, selamat pagi {fahrel}!"


# ============================================
# Kumpulan Fungsi Kalkulator
# ============================================
def tambah(a, b):
    return a + b

def kurang(a, b):
    return a - b

def kali(a, b):
    return a * b

def bagi(a, b):
    if b == 0:
        return "Tidak dapat membagi dengan nol!"
    return a / b

def pangkatkan(angka, eksponen):
    return angka ** eksponen


# ============================================
# Program Utama
# ============================================
user = input("Muhammad Fahrel Adriano: ")
print(salam(user))

while True:
    print("\n=== MENU KALKULATOR ===")
    print("1. Penjumlahan")
    print("2. Pengurangan")
    print("3. Perkalian")
    print("4. Pembagian")
    print("5. Pangkat")
    print("6. Keluar")

    pilihan = input("Pilih opsi (1-6): ")

    if pilihan == "6":
        print("Terima kasih, program dihentikan.")
        break

    x = float(input("Masukkan angka pertama: "))
    y = float(input("Masukkan angka kedua: "))

    if pilihan == "1":
        print("Hasil:", tambah(x, y))
    elif pilihan == "2":
        print("Hasil:", kurang(x, y))
    elif pilihan == "3":
        print("Hasil:", kali(x, y))
    elif pilihan == "4":
        print("Hasil:", bagi(x, y))
    elif pilihan == "5":
        print("Hasil:", pangkatkan(x, y))
    else:
        print("Opsi tidak dikenali!")
