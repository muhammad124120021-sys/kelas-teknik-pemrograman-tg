# Deklarasi variabel untuk harga dan jumlah pembelian buku
harga_A = 50000   # tipe data integer
harga_B = 75000   # tipe data integer
qty_A = int(input("Masukkan jumlah Buku A yang dibeli: "))
qty_B = int(input("Masukkan jumlah Buku B yang dibeli: "))

# Menggunakan operator aritmatika untuk menghitung total sementara
total_sementara = (harga_A * qty_A) + (harga_B * qty_B)

# Menghitung nilai pajak (PPN) sebesar 11%
pajak = total_sementara * 0.11  # sama dengan 11%

# Menggunakan operator penugasan untuk menambah pajak ke total bayar
total_pembayaran = total_sementara
total_pembayaran += pajak

# Menampilkan hasil perhitungan pembelian
print("\n=== Rincian Pembayaran ===")
print(f"Total Sebelum Pajak : Rp {total_sementara}")
print(f"PPN (11%)           : Rp {pajak}")
print(f"Jumlah yang Harus Dibayar : Rp {total_pembayaran}")
