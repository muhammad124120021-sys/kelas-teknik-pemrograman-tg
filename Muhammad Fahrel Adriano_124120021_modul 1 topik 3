# Program untuk mengonversi suhu dari Celcius menjadi Fahrenheit

# Inisialisasi nilai suhu dalam Celcius
suhu_c = 35

# Rumus konversi suhu: (C × 9/5) + 32
suhu_f = (suhu_c * 9/5) + 32

# Menampilkan hasil konversi ke layar
print(f"Hasil konversi: {suhu_f} derajat Fahrenheit")
# Program untuk memeriksa apakah sebuah angka termasuk ganjil atau genap

# Deklarasi variabel angka
nilai = 14

# Kondisi untuk menentukan jenis bilangan
if nilai % 2 == 0:
    print(f"Angka {nilai} merupakan bilangan genap.")
else:
    print(f"Angka {nilai} merupakan bilangan ganjil.")

