import numpy as np
import matplotlib.pyplot as plt

# Membuat matriks 20x50
data = np.zeros((20, 50))

# Ubah nilai di tengah menjadi 1
data[8:12, 20:30] = 1

# Menampilkan matriks sebagai gambar
plt.imshow(data, cmap='gray', aspect='auto')
plt.xlabel('X')
plt.ylabel('Y')
plt.title('Model Penampang 2D Sederhana')
plt.show()
