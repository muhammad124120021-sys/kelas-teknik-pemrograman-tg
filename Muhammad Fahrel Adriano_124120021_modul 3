# ============================================================
# 3.1 KONSEP DASAR KELAS & OBJEK
# ============================================================

class Mahasiswa:
    def __init__(self, nama, nim, prodi):
        self.nama = nama
        self.nim = nim
        self.prodi = prodi

    def tampilkan_data(self):
        print(f"Nama: {self.nama}, NIM: {self.nim}, Prodi: {self.prodi}")


# Contoh objek Mahasiswa
m1 = Mahasiswa("Andi", "12345", "Geofisika")
m2 = Mahasiswa("Budi", "23456", "Geologi")
m3 = Mahasiswa("Citra", "34567", "Teknik Geologi")

m1.tampilkan_data()
m2.tampilkan_data()
