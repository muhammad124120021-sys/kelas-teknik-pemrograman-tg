import random

# Kelas dasar Sensor
class Sensor:
    def __init__(self, id, lokasi):
        self.id = id
        self.lokasi = lokasi
        self.status = "nonaktif"
        self.data = []

    def aktifkan_sensor(self):
        self.status = "aktif"

    def nonaktifkan_sensor(self):
        self.status = "nonaktif"

    def rekam_data(self, nilai):
        if self.status == "aktif":
            self.data.append(nilai)
        else:
            print(f"Sensor {self.id} di {self.lokasi} tidak aktif!")

    def rata_rata_data(self):
        return sum(self.data)/len(self.data) if self.data else 0


# Kelas turunan SensorSeismik
class SensorSeismik(Sensor):
    def __init__(self, id, lokasi, frekuensi):
        super().__init__(id, lokasi)
        self.frekuensi = frekuensi  # Hz

# Kelas turunan SensorGravitasi
class SensorGravitasi(Sensor):
    def __init__(self, id, lokasi, sensitivitas):
        super().__init__(id, lokasi)
        self.sensitivitas = sensitivitas  # mGal

# Membuat beberapa objek sensor
sensor1 = SensorSeismik("S001", "Lampung", 50)
sensor2 = SensorSeismik("S002", "Bandar Lampung", 60)
sensor3 = SensorGravitasi("G001", "Metro", 0.1)
sensor4 = SensorGravitasi("G002", "Tangerang", 0.2)

# List of object untuk semua sensor
daftar_sensor = [sensor1, sensor2, sensor3, sensor4]

# Mengaktifkan semua sensor dan merekam data acak 10 kali
for sensor in daftar_sensor:
    sensor.aktifkan_sensor()
    for _ in range(10):
        if isinstance(sensor, SensorSeismik):
            sensor.rekam_data(round(random.uniform(0.5, 2.0), 2))  # amplitudo seismik
        elif isinstance(sensor, SensorGravitasi):
            sensor.rekam_data(round(random.uniform(9.78, 9.82), 3))  # nilai gravitasi

# Menampilkan laporan semua sensor
print(f"{'ID':<6} {'Lokasi':<15} {'Status':<8} {'Jumlah Data':<12} {'Rata-rata':<10}")
print("-"*60)
for sensor in daftar_sensor:
    print(f"{sensor.id:<6} {sensor.lokasi:<15} {sensor.status:<8} {len(sensor.data):<12} {sensor.rata_rata_data():<10.2f}")

