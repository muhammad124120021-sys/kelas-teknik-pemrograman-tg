# Program untuk menghitung luas dari sebuah lingkaran

# Inisialisasi nilai jari-jari
jari_jari = 9

# Nilai konstanta phi (π)
phi = 3.14

# Proses perhitungan luas lingkaran: π × r²
hasil_luas = phi * (jari_jari ** 2)

# Tampilkan hasil ke layar
print("Hasil perhitungan luas lingkaran =", hasil_luas)
