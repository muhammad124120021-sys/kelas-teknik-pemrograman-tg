# Game sederhana: Tebak Angka

# Menetapkan angka yang harus ditebak
angka_target = 14

# Memulai permainan
print("Hai! Selamat datang di permainan tebak angka!")
print("Coba tebak angka dari 1 hingga 30.")

# Perulangan sampai jawaban pemain benar
while True:
    # Input tebakan dari pengguna
    jawaban = int(input("Masukkan angka tebakanmu: "))

    # Mengevaluasi hasil tebakan
    if jawaban < angka_target:
        print("Tebakanmu terlalu rendah, coba lagi!")
    elif jawaban > angka_target:
        print("Tebakanmu terlalu tinggi, coba lagi!")
    else:
        print("Hebat! Kamu berhasil menebak dengan benar.")
        break  # keluar dari loop bila tebakan benar

# Program mencetak bilangan genap dari 1 sampai 20
print("\nDaftar bilangan genap antara 1 dan 20:")

for angka in range(1, 21):
    if angka % 2 == 0:
        print(angka)
