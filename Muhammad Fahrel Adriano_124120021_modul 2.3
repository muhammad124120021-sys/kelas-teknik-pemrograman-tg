# ==========================================================
# FUNGSI QC SEISMIK
# ==========================================================

def qc_seismik(data, ambang_offset):
    laporan = {}

    for nama_survey, konten in data.items():
        daftar_seismik = konten["seismik"]

        # Siapkan penghitung
        laporan[nama_survey] = {"OK": 0, "BAD": 0}

        for trace in daftar_seismik:

            # Tentukan QC_flag berdasarkan offset
            if trace["offset"] > ambang_offset:
                trace["QC_flag"] = "BAD"
            else:
                trace["QC_flag"] = "OK"

            # Hitung OK/BAD
            laporan[nama_survey][trace["QC_flag"]] += 1

    return laporan


