# PROGRAM UTAMA
# ==========================================================

if __name__ == "__main__":
    # Menjalankan QC dengan ambang offset tertentu
    hasil_qc = qc_seismik(data_survei, ambang_offset=180)

    print("=== LAPORAN QC SEISMIK ===")
    for survey, info in hasil_qc.items():
