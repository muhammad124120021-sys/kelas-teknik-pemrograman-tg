import matplotlib.pyplot as plt

# Data
densitas = [2.0, 2.1, 2.15, 2.3, 2.4, 2.5, 2.55, 2.6]
vp = [2100, 2300, 2400, 2700, 2900, 3100, 3150, 3250]

# Scatter plot
plt.scatter(densitas, vp, color='purple', s=80, edgecolors='k', alpha=0.7)

# Label dan judul
plt.xlabel('Densitas (g/cc)')
plt.ylabel('Vp (m/s)')
plt.title('Scatter Plot: Vp vs Densitas')

plt.grid(True)
plt.show()
